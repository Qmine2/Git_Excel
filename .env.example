# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill it in.   cp .env.example .env
# Never commit the real .env - it holds your tokens.
# ---------------------------------------------------------------------------

# === 1. GitHub ==============================================================

# Personal Access Token.
#   Fine-grained token: Repository access = the repos you want,
#                       Permissions > Repository > Pull requests = Read-only,
#                                     Repository > Metadata = Read-only.
#   Classic token:      scope "repo" for private repos, "public_repo" otherwise.
# Create it at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The GitHub user whose pull requests we collect (your login, case-insensitive).
GITHUB_USERNAME=your-github-login

# Narrow the search. Leave BOTH empty to search every repo you can see. uv run agent.py --dry-run --print-rows --no-llm
# GITHUB_REPO accepts a comma-separated list of "owner/name".
GITHUB_REPO=
GITHUB_ORG=

# Which PRs count:  open | closed | merged | (empty = all)
PR_STATE=

# Which date decides the day a PR lands on:
#   created  -> the day you opened the PR   (default, matches "I worked on it")
#   merged   -> the day it was merged
#   closed   -> the day it was closed
#   updated  -> last activity
PR_DATE_FIELD=created

# Anything else you want appended to the GitHub search query, e.g. "-label:wip"
GITHUB_SEARCH_EXTRA=

# Only change this for GitHub Enterprise Server.
# GITHUB_API_URL=https://github.mycompany.com/api/v3


# === 2. The week ============================================================

# First day of the work week: MON TUE WED THU FRI SAT SUN
# The window is: most recent WEEK_START_DAY (included) -> the day you run it.
WEEK_START_DAY=SAT

# Timezone used to decide which day a PR belongs to.
# Examples: UTC, Europe/Paris, Africa/Tunis, Africa/Casablanca, Asia/Dubai
TIMEZONE=UTC


# === 3. The LLM layer =======================================================

# groq | anthropic | openai | ollama
LLM_PROVIDER=groq

# Free API key: https://console.groq.com -> API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Leave empty to use the provider default.
#   groq      -> llama-3.3-70b-versatile
#               other Groq production models:
#                 llama-3.1-8b-instant   (fastest, cheapest)
#                 openai/gpt-oss-120b    (strongest)
#                 openai/gpt-oss-20b
#   anthropic -> claude-sonnet-5-5
#   openai    -> gpt-4o-mini
#   ollama    -> llama3.1
LLM_MODEL=

# Other providers (only needed if you change LLM_PROVIDER above -
# each one also needs its package: uv sync --extra anthropic)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000

# Force the model to reply with valid JSON (groq and openai only).
# Set to false if a model complains about response_format.
LLM_JSON_MODE=true

# Set to false to skip the LLM and just use PR titles (same as --no-llm).
ENABLE_LLM_DESCRIPTIONS=true

# How the descriptions should read.
DESCRIPTION_LANGUAGE=English
DESCRIPTION_MAX_WORDS=18
DESCRIPTION_STYLE=past tense, concrete, what was actually done


# === 4. Where the rows go ===================================================

# google = Google Sheets   |   xlsx = a local .xlsx file
# This overrides sheet.backend in sheet_config.yaml when it is set.
SHEET_BACKEND=xlsx

# --- xlsx backend ---
XLSX_PATH=weekly_report.xlsx

# --- google backend ---
# The long id in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Path to the service account JSON you downloaded from Google Cloud Console.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Optional: override the tab name from sheet_config.yaml.
WORKSHEET_NAME=

# Optional: use a different mapping file (handy for several sheets).
SHEET_CONFIG_PATH=sheet_config.yaml
